{
  "name": "hexagon",
  "version": "0.2.0",
  "description": "Terminal orchestrator for spec-driven development with multiple AI agents",
  "type": "module",
  "bin": {
    "hexagon": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:bin": "npm run build && node scripts/build-binary.mjs",
    "install:bin": "npm run build && node scripts/build-binary.mjs --install"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
